{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    /*
      * Oras-project/setup-oras actions hosts copy of versioned URLs and checksums
      * As long as pinned version of the action is used the CLI is effectily pinned
      * Note: the pinned version of Oras-project/setup-oras limits the supported version input
        * Renovatebot might suggest updates that are not compatible with the pinned version of the action
    */
    {
      "customType": "regex",
      "description": "Track the ORAS CLI version used by oras-project/setup-oras",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))\\s*\\n\\s*version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?)['\"]?"
      ]
    }
  ]
}
